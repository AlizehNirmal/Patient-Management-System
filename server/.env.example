PORT=5000
# With "npm run db" any password works here. With your own PostgreSQL, use its real password.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medipass_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
CLIENT_URL="http://localhost:5173"

# Email for verification codes (from brevo.com). Leave empty on your PC:
# the code is then printed in the server terminal instead of being emailed.
BREVO_API_KEY=""
MAIL_FROM=""
